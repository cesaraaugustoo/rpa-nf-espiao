# Normaliza finais de linha no repositório; scripts Windows mantêm CRLF no checkout.
* text=auto
*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.csv  text eol=lf
*.yml  text eol=lf
# Arquivos do systemd (VPS Linux): com CRLF o systemd lê "\r" no fim de cada valor.
*.service text eol=lf
*.timer   text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf

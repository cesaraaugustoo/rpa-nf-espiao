ESPIAO_USUARIO=seu-email@exemplo.com
ESPIAO_SENHA=sua-senha

# Alertas por e-mail (opcional; em branco = desligados). Envio pelo Gmail.
# ALERTA_SMTP_SENHA é uma "senha de app" (Conta Google > Segurança > Verificação em duas etapas >
# Senhas de app), não a senha normal da conta.
ALERTA_EMAIL_PARA=destinatario@exemplo.com
ALERTA_SMTP_USUARIO=conta-que-envia@gmail.com
ALERTA_SMTP_SENHA=
